#!/usr/bin/env bash
set -euo pipefail

system=${PROTOS_ENGINE_SPIRIT_SYSTEM:-}
flake_reference=${PROTOS_ENGINE_FLAKE_REFERENCE:-path:.}

if [[ -z "$system" ]]; then
  system=$(nix eval --raw --impure --expr builtins.currentSystem)
fi

temporary_root=$(mktemp -d)
trap 'rm -rf "$temporary_root"' EXIT
mkdir -p "$temporary_root/tmp"
export TMPDIR="$temporary_root/tmp"

# The sink constructs this exact check by narrowing the pinned Spirit owner's
# published test derivation. The test implementation remains in Spirit.
nix build --no-link --print-build-logs \
  "${flake_reference}#checks.${system}.public-text-search-exact-test"
