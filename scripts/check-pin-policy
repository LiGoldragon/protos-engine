#!/usr/bin/env bash
set -euo pipefail

readonly expected_pins=$'capsule-content-identity|LiGoldragon|content-identity|896b21e17f31b66d0802bff899b4b60acea9c0f1\ncontent-identity|LiGoldragon|content-identity|fdf2db1d5a9e8ea52d24d39a03833c3e6885c355\ncore-ethos|LiGoldragon|core-ethos|904dfce385ad9c7bfe0fa894267dd8815df100f4\ncore-logos|LiGoldragon|core-logos|a960aacff8ed13dc14b0ae0094208189d6609434\ncore-nomos|LiGoldragon|core-nomos|2e855607ebf4bc7f40b9328f8fbc78c59ed7926b\nequivalent-core-nomos|LiGoldragon|core-nomos|e1b2febf9f143ab1c84d042d2e9bdd0685303ddc\nlanguage-engine-witness|LiGoldragon|language-engine-witness|37dffb34e355e526b311f6a4d3f8c4764caca668\nlegacy-protos|LiGoldragon|protos|1343d0c405cdb6929552ea6b12c48739e73f35ab\nmeta-signal-spirit|LiGoldragon|meta-signal-spirit|0a7a2438c8e5d57cb1fd413452d0a7ddad4fb9b3\nname-table|LiGoldragon|name-table|50cb4bb53ae2dc4f2516f6912be328ef98ae49f8\nnixpkgs|NixOS|nixpkgs|91cc1fdf6831e29b6c98768e721a72241f3d0797\nnomos-engine|LiGoldragon|nomos-engine|e4230f62b55fcf8543477a26d272862a63aa1fc3\nnomos-protos|LiGoldragon|protos|1263f9d1f73b57885d695ac033bdd6faa1334ddf\nnomos-types|LiGoldragon|nomos-types|a7b831e0540a8ad263cd07ed44ec4c95c56771fb\nprotos|LiGoldragon|protos|95aeb1470c549a404518faf1ab0280a36583a2b3\nraw-discovery|LiGoldragon|raw-discovery|7290f65bbb5e7825ab2ca58340631d154d69d110\nrust-logos|LiGoldragon|rust-logos|306098361221b0f19b82156ab697134520fce8bc\nschema-language|LiGoldragon|schema-language|9c217610c4b8d3bdaa9f95542e28c04424a593e3\nschema-rust|LiGoldragon|schema-rust|3721656b0a654d47d9abde31f14d89d01f9305cf\nsealed-core-nomos|LiGoldragon|core-nomos|ba7abc0b471a0385012b1d8a03cf4942e9da617e\nsema-engine|LiGoldragon|sema-engine|7bed5017a6f20ff2c109f693c2dedaaddf52e64d\nsema-translator|LiGoldragon|sema-translator|6df830ab1ec9f315a5b50e40ffc393b48ea3d412\nsignal-frame|LiGoldragon|signal-frame|0786fbe8caf27552afcdd5deb85bc82ec6088337\nsignal-nomos|LiGoldragon|signal-nomos|1af71a9d0625a6404f81cd6fe8b6393ac0c9040f\nsignal-sema-translator|LiGoldragon|sig