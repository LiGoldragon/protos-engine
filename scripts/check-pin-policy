#!/usr/bin/env bash
set -euo pipefail

readonly expected_pins=$'content-identity|LiGoldragon|content-identity|fdf2db1d5a9e8ea52d24d39a03833c3e6885c355\ncore-ethos|LiGoldragon|core-ethos|700310a0778d164b151a8301cccb4f53bc6fbde1\ncore-logos|LiGoldragon|core-logos|13e600ec74532f3037850f5d9985c05905456a20\ncore-nomos|LiGoldragon|core-nomos|de2518cdff686b463ecaf88cc1241fbf28a27dfe\nlanguage-engine-witness|LiGoldragon|language-engine-witness|c6f3649502ce196be64a635bf0c76673be4440cb\nmeta-signal-spirit|LiGoldragon|meta-signal-spirit|0a7a2438c8e5d57cb1fd413452d0a7ddad4fb9b3\nname-table|LiGoldragon|name-table|50cb4bb53ae2dc4f2516f6912be328ef98ae49f8\nnixpkgs|NixOS|nixpkgs|91cc1fdf6831e29b6c98768e721a72241f3d0797\nprotos|LiGoldragon|protos|1343d0c405cdb6929552ea6b12c48739e73f35ab\nraw-discovery|LiGoldragon|raw-discovery|7290f65bbb5e7825ab2ca58340631d154d69d110\nrust-logos|LiGoldragon|rust-logos|b96a474ee0ec6e7782c18f247d17f112b25ffbaa\nschema-language|LiGoldragon|schema-language|9c217610c4b8d3bdaa9f95542e28c04424a593e3\nschema-rust|LiGoldragon|schema-rust|3721656b0a654d47d9abde31f14d89d01f9305cf\nsema-translator|LiGoldragon|sema-translator|7e9e85bb9d199f24b968bcd49a351e910469f5b5\nsignal-sema-translator|LiGoldragon|signal-sema-translator|dd8e7b5656833f640e49c099ab3be6f09881f9c5\nsignal-spirit|LiGoldragon|signal-spirit|1cf7c010029de46369b742687da4fa1ca6def9a9\nspirit|LiGoldragon|spirit|1049b8a1a9e3c2be7ece3553b89c7e3815939d43\nstructural-codec|LiGoldragon|structural-codec|6769015f5a040dd158f0a76b3962f31ee8e4f16e'
readonly expected_input_names=$'content-identity\ncore-ethos\ncore-logos\ncore-nomos\nlanguage-engine-witness\nmeta-signal-spirit\nname-table\nnixpkgs\nprotos\nraw-discovery\nrust-logos\nschema-language\nschema-rust\nsema-translator\nsignal-sema-translator\nsignal-spirit\nspirit\nstructural-codec'

validate_lock_policy() {
  local lock_file=$1
  local actual_input_names
  local input_name
  local owner
  local repository
  local revision
  local node_name

  jq -e '
    type == "object"
    and (.version == 7)
    and (.root | type == "string")
    and (.nodes | type == "object")
    and (.nodes[.root].inputs | type == "object")
  ' "$lock_file" >/dev/null || {
    echo "flake.lock does not have the expected structural root" >&2
    return 1
  }

  actual_input_names=$(
    jq -r '.root as $root | .nodes[$root].inputs | keys[]' "$lock_file"
  )
  if [[ "$actual_input_names" != "$expected_input_names" ]]; then
    echo "root source-input names differ from the exact policy set" >&2
    diff -u <(printf '%s\n' "$expected_input_names") \
      <(printf '%s\n' "$actual_input_names") >&2 || true
    return 1
  fi

  while IFS='|' read -r input_name owner repository revision; do
    node_name=$(
      jq -er --arg input_name "$input_name" '
        .root as $root
        | .nodes[$root].inputs[$input_name]
        | select(type == "string")
      ' "$lock_file"
    ) || {
      echo "root input is not a direct locked node: $input_name" >&2
      return 1
    }

    jq -e \
      --arg node_name "$node_name" \
      --arg owner "$owner" \
      --arg repository "$repository" \
      --arg revision "$revision" '
        .nodes[$node_name] as $node
        | ($revision | test("^[0-9a-f]{40}$"))
          and (($node.original | keys | sort) == ["owner", "repo", "rev", "type"])
          and ($node.original.type == "github")
          and ($node.original.owner == $owner)
          and ($node.original.repo == $repository)
          and ($node.original.rev == $revision)
          and (($node.original.rev | test("^[0-9a-f]{40}$")))
          and ($node.locked.type == "github")
          and ($node.locked.owner == $owner)
          and ($node.locked.repo == $repository)
          and ($node.locked.rev == $revision)
          and (($node.locked.rev | test("^[0-9a-f]{40}$")))
          and ($node.locked.narHash | type == "string")
          and ($node.locked.narHash | startswith("sha256-"))
          and (($node.locked.narHash | length) > 8)
          and (($node.locked | has("ref")) | not)
          and (($node.locked | has("path")) | not)
      ' "$lock_file" >/dev/null || {
      echo "root input violates exact immutable pin policy: $input_name" >&2
      return 1
    }
  done < <(printf '%s\n' "$expected_pins")

  jq -e '
    all(
      .nodes[];
      if ((.original? // {}) | has("ref")) then
        (.locked.rev | type == "string")
        and (.locked.rev | test("^[0-9a-f]{40}$"))
        and (.locked.narHash | type == "string")
        and (.locked.narHash | startswith("sha256-"))
        and ((.locked.narHash | length) > 8)
      else
        true
      end
    )
  ' "$lock_file" >/dev/null || {
    echo "transitive branch metadata lacks an immutable locked revision and narHash" >&2
    return 1
  }
}

repository_status() {
  local repository_root=$1

  if [[ -w "$repository_root/.jj" ]]; then
    jj --repository "$repository_root" status
  else
    printf 'no-writable-jujutsu-working-copy\n'
  fi
}

evaluate_live_metadata() {
  local repository_root=$1
  local metadata_file=$2

  nix flake metadata \
    --json \
    --no-write-lock-file \
    "path:$repository_root" > "$metadata_file"
}

validate_live_policy() {
  local repository_root=$1
  local lock_file="$repository_root/flake.lock"
  local temporary_root
  local metadata_file
  local evaluated_lock_file
  local lock_hash_before
  local lock_hash_after
  local status_before
  local status_after

  [[ -f "$repository_root/flake.nix" && -f "$lock_file" ]] || {
    echo "live pin policy requires flake.nix and flake.lock" >&2
    return 1
  }
  if [[ -w "$repository_root/.jj" ]]; then
    if ! jj --repository "$repository_root" diff --quiet -- flake.lock; then
      echo "flake.lock has uncommitted working-copy changes" >&2
      return 1
    fi
  fi

  validate_lock_policy "$lock_file"
  temporary_root=$(mktemp -d)
  metadata_file="$temporary_root/metadata.json"
  evaluated_lock_file="$temporary_root/evaluated-locks.json"
  lock_hash_before=$(sha256sum "$lock_file")
  status_before=$(repository_status "$repository_root")

  if ! evaluate_live_metadata "$repository_root" "$metadata_file"; then
    rm -rf "$temporary_root"
    echo "live flake metadata evaluation failed" >&2
    return 1
  fi

  lock_hash_after=$(sha256sum "$lock_file")
  status_after=$(repository_status "$repository_root")
  if [[ "$lock_hash_before" != "$lock_hash_after" ]]; then
    rm -rf "$temporary_root"
    echo "live metadata evaluation rewrote flake.lock" >&2
    return 1
  fi
  if [[ "$status_before" != "$status_after" ]]; then
    rm -rf "$temporary_root"
    echo "live metadata evaluation changed repository status" >&2
    return 1
  fi

  jq -e --slurp '
    (.[1] | type == "object")
    and (.[1].locks | type == "object")
    and (.[0] == .[1].locks)
  ' "$lock_file" "$metadata_file" >/dev/null || {
    rm -rf "$temporary_root"
    echo "evaluated metadata declarations differ from committed flake.lock" >&2
    return 1
  }

  jq -e '.locks' "$metadata_file" > "$evaluated_lock_file"
  validate_lock_policy "$evaluated_lock_file"
  rm -rf "$temporary_root"
}

mutate_lock() {
  local lock_file=$1
  local jq_program=$2
  local mutated_lock=$3

  jq "$jq_program" "$lock_file" > "$mutated_lock"
}

expect_lock_rejection() {
  local label=$1
  local lock_file=$2

  if validate_lock_policy "$lock_file" >/dev/null 2>&1; then
    echo "lock mutation unexpectedly passed: $label" >&2
    return 1
  fi
}

run_lock_self_test() {
  local lock_file=$1
  local temporary_root
  local node_expression

  validate_lock_policy "$lock_file"
  temporary_root=$(mktemp -d)
  trap 'rm -rf "$temporary_root"' RETURN

  # shellcheck disable=SC2016
  node_expression='.root as $root
    | .nodes[$root].inputs["content-identity"] as $node
    | .nodes[$node].original = {
        "type": "github",
        "owner": "LiGoldragon",
        "repo": "content-identity",
        "ref": "main"
      }'
  mutate_lock "$lock_file" "$node_expression" "$temporary_root/branch.lock"
  expect_lock_rejection "root branch input" "$temporary_root/branch.lock"

  # shellcheck disable=SC2016
  node_expression='.root as $root
    | .nodes[$root].inputs["content-identity"] as $node
    | .nodes[$node].original = {
        "type": "path",
        "path": "../content-identity"
      }'
  mutate_lock "$lock_file" "$node_expression" "$temporary_root/path.lock"
  expect_lock_rejection "root path input" "$temporary_root/path.lock"

  # shellcheck disable=SC2016
  node_expression='.root as $root
    | .nodes[$root].inputs["unexpected-engine"] = "content-identity"'
  mutate_lock "$lock_file" "$node_expression" "$temporary_root/extra.lock"
  expect_lock_rejection "extra root input" "$temporary_root/extra.lock"

  # shellcheck disable=SC2016
  node_expression='first(
      .nodes
      | to_entries[]
      | select(.value.original.ref? != null)
      | .key
    ) as $node
    | del(.nodes[$node].locked.narHash)'
  mutate_lock "$lock_file" "$node_expression" "$temporary_root/transitive.lock"
  expect_lock_rejection "unlocked transitive branch input" \
    "$temporary_root/transitive.lock"
}

copy_flake_fixture() {
  local repository_root=$1
  local fixture=$2

  mkdir -p "$fixture/scripts"
  cp "$repository_root/AGENTS.md" "$fixture/AGENTS.md"
  cp "$repository_root/ARCHITECTURE.md" "$fixture/ARCHITECTURE.md"
  cp "$repository_root/README.md" "$fixture/README.md"
  cp "$repository_root/flake.lock" "$fixture/flake.lock"
  cp "$repository_root/flake.nix" "$fixture/flake.nix"
  cp "$repository_root/scripts/"* "$fixture/scripts/"
  chmod -R u+w "$fixture"
  chmod +x "$fixture/scripts/"*
}

expect_live_rejection_without_lock_write() {
  local label=$1
  local fixture=$2
  local temporary_root
  local metadata_file
  local lock_hash_before
  local lock_hash_after

  temporary_root=$(mktemp -d)
  metadata_file="$temporary_root/metadata.json"
  lock_hash_before=$(sha256sum "$fixture/flake.lock")
  if ! evaluate_live_metadata "$fixture" "$metadata_file" >/dev/null 2>&1; then
    rm -rf "$temporary_root"
    echo "live declaration mutation did not produce evaluated metadata: $label" >&2
    return 1
  fi
  jq -e '.locks.nodes[.locks.root].inputs | type == "object"' \
    "$metadata_file" >/dev/null || {
    rm -rf "$temporary_root"
    echo "live declaration mutation metadata lacks evaluated root inputs: $label" >&2
    return 1
  }
  if validate_live_policy "$fixture" >/dev/null 2>&1; then
    rm -rf "$temporary_root"
    echo "live declaration mutation unexpectedly passed: $label" >&2
    return 1
  fi
  lock_hash_after=$(sha256sum "$fixture/flake.lock")
  if [[ "$lock_hash_before" != "$lock_hash_after" ]]; then
    rm -rf "$temporary_root"
    echo "rejected live declaration mutation rewrote its stale lock: $label" >&2
    return 1
  fi
  rm -rf "$temporary_root"
}

replace_content_identity_declaration() {
  local flake_file=$1
  local replacement=$2

  sed -i \
    "s#github:LiGoldragon/content-identity/fdf2db1d5a9e8ea52d24d39a03833c3e6885c355#$replacement#" \
    "$flake_file"
}

run_live_self_test() {
  local repository_root=$1
  local temporary_root

  validate_live_policy "$repository_root"
  temporary_root=$(mktemp -d)
  trap 'rm -rf "$temporary_root"' RETURN

  copy_flake_fixture "$repository_root" "$temporary_root/branch"
  replace_content_identity_declaration \
    "$temporary_root/branch/flake.nix" \
    "github:LiGoldragon/content-identity/main"
  expect_live_rejection_without_lock_write \
    "branch declaration with stale lock" "$temporary_root/branch"

  copy_flake_fixture "$repository_root" "$temporary_root/path"
  replace_content_identity_declaration \
    "$temporary_root/path/flake.nix" \
    "path:/git/github.com/LiGoldragon/content-identity"
  expect_live_rejection_without_lock_write \
    "path declaration with stale lock" "$temporary_root/path"

  copy_flake_fixture "$repository_root" "$temporary_root/identity"
  replace_content_identity_declaration \
    "$temporary_root/identity/flake.nix" \
    "github:NixOS/nixpkgs/91cc1fdf6831e29b6c98768e721a72241f3d0797"
  expect_live_rejection_without_lock_write \
    "owner repository revision declaration mismatch" \
    "$temporary_root/identity"

  copy_flake_fixture "$repository_root" "$temporary_root/dirty-lock"
  jj git init --colocate "$temporary_root/dirty-lock" >/dev/null 2>&1
  jj --repository "$temporary_root/dirty-lock" \
    commit -m "freeze pin-policy fixture" >/dev/null 2>&1
  printf '\n' >> "$temporary_root/dirty-lock/flake.lock"
  if validate_live_policy "$temporary_root/dirty-lock" >/dev/null 2>&1; then
    echo "live policy unexpectedly accepted a dirty flake.lock" >&2
    return 1
  fi
}

case ${1:-} in
  --lock-only)
    (( $# == 2 )) || {
      echo "usage: check-pin-policy --lock-only FLAKE_LOCK" >&2
      exit 2
    }
    validate_lock_policy "$2"
    echo "committed lock uses the exact immutable root source-input set"
    ;;
  --lock-self-test)
    (( $# == 2 )) || {
      echo "usage: check-pin-policy --lock-self-test FLAKE_LOCK" >&2
      exit 2
    }
    run_lock_self_test "$2"
    echo "lock mutations reject branch, path, extra-root, and unlocked transitive inputs"
    ;;
  --self-test)
    (( $# == 2 )) || {
      echo "usage: check-pin-policy --self-test REPOSITORY_ROOT" >&2
      exit 2
    }
    run_live_self_test "$2"
    echo "live mutations reject branch, path, identity drift, and dirty lock without rewrites"
    ;;
  "")
    echo "usage: check-pin-policy REPOSITORY_ROOT" >&2
    exit 2
    ;;
  *)
    (( $# == 1 )) || {
      echo "usage: check-pin-policy REPOSITORY_ROOT" >&2
      exit 2
    }
    validate_live_policy "$1"
    echo "live evaluated metadata matches the clean committed lock and exact root policy"
    ;;
esac
