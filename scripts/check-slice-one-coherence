#!/usr/bin/env bash
set -euo pipefail

# These are the complete direct producer edges for the current bootstrap
# language path. The separately pinned Nomos wire closure keeps its own typed
# producer graph; its root revisions and owner process evidence are checked
# without pretending that closure is the same generation as this path.
readonly expected_edges=$'structural-codec|name-table|name-table|\nstructural-codec|raw-discovery|raw-discovery|\ncore-ethos|encoded-name-table|name-table|name-table\ncore-ethos|signal-sema-translator|signal-sema-translator|\ncore-ethos|raw-discovery|raw-discovery|\ncore-ethos|structural-codec|structural-codec|\ncore-logos|encoded-name-table|name-table|name-table\ncore-logos|signal-sema-translator|signal-sema-translator|\ncore-logos|structural-codec|structural-codec|\ncore-nomos|encoded-name-table|name-table|name-table\ncore-nomos|signal-sema-translator|signal-sema-translator|\ncore-nomos|core-ethos|core-ethos|\ncore-nomos|core-logos|core-logos|\ncore-nomos|raw-discovery|raw-discovery|\ncore-nomos|textual-rust|rust-logos|rust-logos\ncore-nomos|structural-codec|structural-codec|\nrust-logos|core-logos|core-logos|\nrust-logos|name-table|name-table|\nrust-logos|raw-discovery|raw-discovery|\nrust-logos|signal-sema-translator|signal-sema-translator|\nrust-logos|structural-codec|structural-codec|\nprotos|signal-frame|signal-frame|\nlanguage-engine-witness|sema-engine|sema-engine|\nlanguage-engine-witness|signal-domain|signal-domain|\nlanguage-engine-witness|signal-nomos|signal-nomos|\nlanguage-engine-witness|slice-core-ethos|core-ethos|core-ethos\nlanguage-engine-witness|slice-core-logos|core-logos|core-logos\nlanguage-engine-witness|slice-core-nomos|core-nomos|core-nomos\nlanguage-engine-witness|slice-name-table|name-table|name-table\nlanguage-engine-witness|slice-raw-discovery|raw-discovery|raw-discovery\nlanguage-engine-witness|slice-rust-logos|rust-logos|rust-logos\nlanguage-engine-witness|slice-sema-translator|sema-translator|sema-translator\nlanguage-engine-witness|slice-signal-frame|signal-frame|signal-frame\nlanguage-engine-witness|slice-signal-sema-translator|signal-sema-translator|signal-sema-translator\nlanguage-engine-witness|slice-structural-codec|structural-codec|structural-codec'

root_revision() {
  local lock_file=$1
  local input_name=$2

  jq -er --arg input_name "$input_name" '
    .root as $root
    | .nodes[$root].inputs[$input_name] as $node_name
    | select($node_name | type == "string")
    | .nodes[$node_name].locked.rev
    | select(type == "string" and test("^[0-9a-f]{40}$"))
  ' "$lock_file"
}

source_path() {
  local source_map_file=$1
  local source_name=$2

  jq -er --arg source_name "$source_name" '
    .[$source_name]
    | select(type == "string" and length > 0)
  ' "$source_map_file"
}

dependency_declaration() {
  local manifest=$1
  local dependency_name=$2
  local declarations

  declarations=$(
    LC_ALL=C grep -E \
      "^[[:space:]]*${dependency_name}[[:space:]]*=" "$manifest" || true
  )
  if [[ $(printf '%s\n' "$declarations" | sed '/^$/d' | wc -l) -ne 1 ]]; then
    echo "expected exactly one Slice One dependency: $manifest:$dependency_name" >&2
    return 1
  fi
  printf '%s\n' "$declarations"
}

validate_direct_edge() {
  local source_map_file=$1
  local lock_file=$2
  local source_name=$3
  local dependency_name=$4
  local target_name=$5
  local package_name=$6
  local source_root
  local manifest
  local target_revision
  local target_git
  local target_repository
  local declaration
  local compact_declaration

  source_root=$(source_path "$source_map_file" "$source_name") || {
    echo "Slice One source is absent from the root source map: $source_name" >&2
    return 1
  }
  manifest="$source_root/Cargo.toml"
  [[ -f "$manifest" && ! -L "$manifest" ]] || {
    echo "Slice One source lacks a regular Cargo.toml: $source_name" >&2
    return 1
  }

  target_revision=$(root_revision "$lock_file" "$target_name") || {
    echo "Slice One target is not an exact direct root pin: $target_name" >&2
    return 1
  }
  case $target_name in
    capsule-content-identity)
      target_repository=content-identity
      ;;
    *)
      target_repository=$target_name
      ;;
  esac
  target_git="https://github.com/LiGoldragon/${target_repository}.git"
  declaration=$(dependency_declaration "$manifest" "$dependency_name") ||
    return 1
  compact_declaration=$(printf '%s\n' "$declaration" | tr -d '[:space:]')

  if [[ "$compact_declaration" != *"git=\"$target_git\""* ]]; then
    echo "Slice One edge targets the wrong repository: $source_name -> $dependency_name" >&2
    return 1
  fi
  if [[ "$compact_declaration" != *"rev=\"$target_revision\""* ]]; then
    echo "Slice One edge differs from the root revision: $source_name -> $dependency_name" >&2
    return 1
  fi
  if [[ -n "$package_name" &&
    "$compact_declaration" != *"package=\"$package_name\""* ]]; then
    echo "Slice One alias targets the wrong package: $source_name -> $dependency_name" >&2
    return 1
  fi
}

require_source_pattern() {
  local source_file=$1
  local label=$2
  local pattern=$3

  if ! LC_ALL=C grep -Eq "$pattern" "$source_file"; then
    echo "Slice One behavior witness lacks executable evidence: $label" >&2
    return 1
  fi
}

reject_source_pattern() {
  local source_file=$1
  local label=$2
  local pattern=$3

  if LC_ALL=C grep -Eq "$pattern" "$source_file"; then
    echo "Slice One behavior witness retains refused evidence: $label" >&2
    return 1
  fi
}

validate_bootstrap_fixture() {
  local fixture=$1
  local kind=$2
  local body_pattern=$3

  if [[ $(sed -n '1p' "$fixture") != "$kind.{1 0 0}" ||
    $(sed -n '2p' "$fixture") != '[]' ||
    $(sed -n '3p' "$fixture") != '{' ||
    $(tail -n 1 "$fixture") != '}' ]]; then
    echo "Slice One behavior witness lacks $kind header/import/body framing" >&2
    return 1
  fi
  require_source_pattern "$fixture" "$kind body" "$body_pattern"
}

validate_behavior_witness() {
  local source_map_file=$1
  local lock_file=$2
  local witness_root
  local witness_flake
  local slice_test
  local slice_fixture
  local spirit_domain_test
  local spirit_domain_fixture
  local support_module
  local signal_domain_revision
  local nomos_engine_revision
  local restart_test
  local sema_root
  local sema_fixture
  local sema_generated_test
  local sema_generated_rust
  local sema_support_module

  witness_root=$(source_path "$source_map_file" language-engine-witness) || {
    echo "Slice One behavior witness is absent from the root source map" >&2
    return 1
  }
  witness_flake="$witness_root/flake.nix"
  slice_test="$witness_root/tests/slice_one.rs"
  slice_fixture="$witness_root/tests/fixtures/slice-one-newtype.ethos"
  spirit_domain_test="$witness_root/tests/spirit_domain.rs"
  spirit_domain_fixture="$witness_root/tests/fixtures/spirit-domain.ethos"
  support_module="$witness_root/tests/support/mod.rs"
  restart_test="$witness_root/tests/nomos_authority_process.rs"
  [[ -f "$witness_flake" && ! -L "$witness_flake" &&
    -f "$slice_test" && ! -L "$slice_test" &&
    -f "$slice_fixture" && ! -L "$slice_fixture" &&
    -f "$spirit_domain_test" && ! -L "$spirit_domain_test" &&
    -f "$spirit_domain_fixture" && ! -L "$spirit_domain_fixture" &&
    -f "$support_module" && ! -L "$support_module" &&
    -f "$restart_test" && ! -L "$restart_test" ]] || {
    echo "Slice One behavior witness lacks regular owner test surfaces" >&2
    return 1
  }

  nomos_engine_revision=$(root_revision "$lock_file" nomos-engine)
  require_source_pattern "$witness_flake" "exact process-only Nomos engine" \
    "github:LiGoldragon/nomos-engine/${nomos_engine_revision}"

  sema_root=$(source_path "$source_map_file" sema-engine) || {
    echo "Sema behavior witness is absent from the root source map" >&2
    return 1
  }
  sema_fixture="$sema_root/schema/witness.sema"
  sema_generated_test="$sema_root/tests/generated_table.rs"
  sema_generated_rust="$sema_root/tests/fixtures/generated_sema_table.rs"
  sema_support_module="$sema_root/tests/support/mod.rs"
  [[ -f "$sema_fixture" && ! -L "$sema_fixture" &&
    -f "$sema_generated_test" && ! -L "$sema_generated_test" &&
    -f "$sema_generated_rust" && ! -L "$sema_generated_rust" &&
    -f "$sema_support_module" && ! -L "$sema_support_module" ]] || {
    echo "Sema behavior witness lacks regular owner source and test surfaces" >&2
    return 1
  }

  validate_bootstrap_fixture "$slice_fixture" Nexus \
    'Identifiers[.]Vector<Integer> Status[.][[]Pending Ready[.]Integer Batch[.][{]Vector<Integer> Integer[}][]]'
  require_source_pattern "$slice_test" "Nexus unit, unary, and product semantics" \
    '^fn nexus_bootstrap_lowers_and_runs_unit_unary_and_product_semantics[(][)]'
  require_source_pattern "$slice_test" "canonical Nexus source transaction" \
    'assert_eq![(]assembly[.]canonical_source[(][)], NEXUS_SOURCE[)][;]'
  require_source_pattern "$slice_test" "authority-verified bootstrap lowering" \
    'BootstrapSliceOneLowering::new[(][)]'
  require_source_pattern "$slice_test" "sealed transaction boundary" \
    '[.]lower[(]assembly[.]reader[(][)], assembly[.]transaction[(][)][)]'
  require_source_pattern "$slice_test" "whole Logos identity" \
    'logos[.]content_identity[(][)][.]expect[(]"whole Logos identity"[)]'
  require_source_pattern "$slice_test" "Whole Logos archive recovery" \
    'WholeLogos::from_archive_bytes[(]&archive[)]'
  require_source_pattern "$slice_test" "structural Rust emission" \
    '[.]emit_fixture[(]&restored, &projections[(]&ids[)][)]'
  require_source_pattern "$slice_test" "structural Rust decode" \
    'rust[.]decode_fixture[(]&emitted, &emitted_bindings[(]&emitted, &ids[)][)]'
  require_source_pattern "$slice_test" "unit variant carrier" \
    'WholeLogosVariantPayload::Unit'
  require_source_pattern "$slice_test" "tuple variant carrier" \
    'WholeLogosVariantPayload::Tuple'
  require_source_pattern "$slice_test" "no-partial-emission refusal" \
    '^fn incomplete_projection_refuses_without_partial_rust[(][)]'
  require_source_pattern "$slice_test" "scratch Cargo execution" \
    '^[[:space:]]*let run = Command::new[(]"cargo"[)]'
  require_source_pattern "$slice_test" "generated behavior output" \
    '"3 42\\n"'
  require_source_pattern "$slice_test" "exact published bootstrap train" \
    '^fn vertical_slice_pins_the_published_bootstrap_train[(][)]'
  reject_source_pattern "$slice_test" "retired six-slot source vocabulary" \
    'six-slot|SixSlot'

  validate_bootstrap_fixture "$sema_fixture" Sema \
    'Domain[.]String DomainSnapshot[.][{]Domain Integer String[}]'
  require_source_pattern "$sema_support_module" "canonical Sema source assembly" \
    '[.]assemble[(]include_str![(]"[.][.]/[.][.]/schema/witness[.]sema"[)], approval[)]'
  require_source_pattern "$sema_support_module" "authority-verified Sema generation" \
    'BootstrapSemaGeneration::new[(]'
  require_source_pattern "$sema_generated_rust" "checked Sema projection marker" \
    '^// @generated by schema-rust from an authority-verified bootstrap Sema$'
  require_source_pattern "$sema_generated_test" "checked source/projection freshness" \
    '^fn checked_sema_source_and_generated_rust_are_fresh[(][)]'
  require_source_pattern "$sema_generated_test" "generated typed table runtime" \
    '^fn generated_domain_snapshot_table_writes_and_reads_a_typed_domain_key[(][)]'
  require_source_pattern "$sema_generated_test" "generated table registration" \
    '[.]register_table[(]z2VKo3::descriptor[(][)][)]'

  validate_bootstrap_fixture "$spirit_domain_fixture" Interface \
    'DomainScope[.]ScopeOf<Domain> DomainScopes[.]Vector<DomainScope> ScopeSet[.]Vector<DomainScope>'
  require_source_pattern "$support_module" "canonical Interface fixture inclusion" \
    '^pub const SOURCE: &str = include_str![(]"[.][.]/fixtures/spirit-domain[.]ethos"[)][;]'
  signal_domain_revision=$(root_revision "$lock_file" signal-domain)
  require_source_pattern "$support_module" "exact signal-domain source revision" \
    "^pub const SIGNAL_DOMAIN_REVISION: &str = \"${signal_domain_revision}\"[;]"
  require_source_pattern "$spirit_domain_test" "complete Spirit Interface transaction" \
    '^fn complete_spirit_domain_is_one_verified_transaction_through_rust[(][)]'
  require_source_pattern "$spirit_domain_test" "canonical Interface source transaction" \
    'assert_eq![(]assembly[.]canonical_source[(][)], SOURCE[)][;]'
  require_source_pattern "$spirit_domain_test" "published runtime source equality" \
    'signal_domain::DOMAIN_INTERFACE_SOURCE'
  require_source_pattern "$spirit_domain_test" "decoded Interface body" \
    'BootstrapBody::Interface[(]body[)]'
  require_source_pattern "$spirit_domain_test" "41-item Spirit inventory" \
    'assert_eq![(]body[.]types[.]len[(][)], 41[)][;]'
  require_source_pattern "$spirit_domain_test" "complete Spirit inventory" \
    '[(]38, 3, 369, 37[)]'
  require_source_pattern "$spirit_domain_test" "typed ScopeOf application" \
    'manifest::SCOPEOF_SEAT[.]local'
  require_source_pattern "$spirit_domain_test" "typed Vector applications" \
    'manifest::VECTOR_SEAT[.]local'
  require_source_pattern "$spirit_domain_test" "complete authority-verified lowering" \
    'BootstrapSliceOneLowering::new[(][)]'
  require_source_pattern "$spirit_domain_test" "sealed Spirit transaction boundary" \
    '[.]lower[(]assembly[.]reader[(][)], assembly[.]transaction[(][)][)]'
  require_source_pattern "$spirit_domain_test" "complete Spirit Logos archive recovery" \
    'WholeLogos::from_archive_bytes[(]&archived[)]'
  require_source_pattern "$spirit_domain_test" "complete production Rust emission" \
    '[.]emit_with_type_paths[(]&restored, assembly[.]resolver[(][)], &DomainRustTypePaths::new[(][)][)]'
  require_source_pattern "$spirit_domain_test" "byte-identical producer projection" \
    'signal_domain::DOMAIN_INTERFACE_RUST'
  reject_source_pattern "$spirit_domain_test" "fixture emission on the Spirit completion path" \
    '[.]emit_fixture[(]'
  require_source_pattern "$spirit_domain_test" "369-variant scratch behavior" \
    '^[[:space:]]*"369\\n"'
  require_source_pattern "$spirit_domain_test" "fixture/runtime source pin witness" \
    '^fn fixture_and_runtime_type_share_the_exact_published_source[(][)]'
  require_source_pattern "$spirit_domain_test" "absence of schema-rust runtime dependency" \
    'assert![(]!CARGO_MANIFEST[.]contains[(]"schema-rust"[)][)][;]'

  require_source_pattern "$restart_test" "current bootstrap process boundary" \
    '^fn current_bootstrap_transform_succeeds_in_process_and_refuses_the_unarchived_wire[(][)]'
  require_source_pattern "$restart_test" "unarchived bootstrap boundary" \
    'BootstrapArchiveStatus::NotYetArchived'
  require_source_pattern "$restart_test" "authority-verified in-process lowering" \
    'BootstrapSliceOneLowering::new[(][)]'
  require_source_pattern "$restart_test" "current Nomos wire request" \
    '&NomosRequest::Transform [{]'
  require_source_pattern "$restart_test" "unarchived wire refusal" \
    'NomosReply::Rejected[(]NomosRejection::EthosPopulationInvalid[)]'
  require_source_pattern "$restart_test" "current process producer pins" \
    '^fn current_process_dependencies_pin_the_published_producers[(][)]'
  require_source_pattern "$restart_test" "authored Nomos authority transaction" \
    '^fn authored_nomos_seals_recovers_and_renames_through_the_authority_process[(][)]'
  require_source_pattern "$restart_test" "isolated authority state" \
    '^[[:space:]]*let directory = tempfile::tempdir[(][)][.]expect[(]"isolated authority directory"[)][;]'
  require_source_pattern "$restart_test" "bounded process readiness" \
    'receiver[.]recv_timeout[(]PROCESS_STARTUP_TIMEOUT[)]'
  require_source_pattern "$restart_test" "bounded process reads" \
    '[.]set_read_timeout[(]Some[(]PROCESS_IO_TIMEOUT[)][)]'
  require_source_pattern "$restart_test" "bounded process writes" \
    '[.]set_write_timeout[(]Some[(]PROCESS_IO_TIMEOUT[)][)]'
  require_source_pattern "$restart_test" "direct big-endian Nomos framing" \
    '^[[:space:]]*[.]to_be_bytes[(][)][,]'
  require_source_pattern "$restart_test" "one authored Nomos plan" \
    '[.]plan_load[(]'
  require_source_pattern "$restart_test" "authority seal request" \
    'AuthorityOperation::SealUniversal[(]planned[.]request[(][)][.]clone[(][)][)]'
  require_source_pattern "$restart_test" "unread receipt refusal" \
    'NomosLoadError::ReceiptNotDurableSeal'
  require_source_pattern "$restart_test" "durable receipt read" \
    'ReadOperation::CommittedReceipt [{]'
  require_source_pattern "$restart_test" "durable receipt materialization" \
    '[.]complete_load[(]&planned, &durable, &fixed[)]'
  require_source_pattern "$restart_test" "authored recursive enumeration declaration" \
    '^ScopeOfStep[.]Recursive[.]Enumeration [{]$'
  require_source_pattern "$restart_test" "authored recursive self Invoke" \
    '^Invoke[.]ScopeOfStep$'
  require_source_pattern "$restart_test" "boundary-zero InsertAt" \
    '^InsertAt[.]children 0 rustfmt[.]skip$'
  require_source_pattern "$restart_test" "authority termination before recovery" \
    '^[[:space:]]*daemon[.]stop[(][)][;]'
  require_source_pattern "$restart_test" "same-state authority recovery" \
    '^[[:space:]]*let mut recovered_daemon = Daemon::start[(]&socket, &database[)][;]'
  require_source_pattern "$restart_test" "recovered durable receipt" \
    'assert_eq![(]recovered_receipt, &receipt[)][;]'
  require_source_pattern "$restart_test" "authorized spelling-only rename" \
    'AuthorityOperation::Rename[(]Rename [{]'
  require_source_pattern "$restart_test" "renamed InsertAt canonical projection" \
    'InsertAt[.]descendants 0 rustfmt[.]skip'
  require_source_pattern "$restart_test" "unresolved authored reference refusal" \
    'AuthorityReply::Rejected[(]NoWriteFailure::UnresolvedReference [{] [.][.] [}][)]'
  require_source_pattern "$restart_test" "one-request file population" \
    '^fn authored_nomos_manifest_is_one_process_request_and_graph_failures_leave_no_receipt[(][)]'
  require_source_pattern "$restart_test" "complete manifest planning" \
    '[.]plan_file_population[(]'
  require_source_pattern "$restart_test" "single manifest authority request" \
    'assert_eq![(]planned[.]request[(][)][.]declarations[.]len[(][)], 1[)][;]'
  require_source_pattern "$restart_test" "external Invoke refusal" \
    'NomosManifestLoadError::ExternalInvoke[(]modules, spelling[)]'
  require_source_pattern "$restart_test" "missing dependency refusal" \
    'NomosManifestLoadError::MissingDependency[(]_, _[)]'
  require_source_pattern "$restart_test" "dependency cycle refusal" \
    'NomosManifestLoadError::DependencyCycle[(]_[)]'
  require_source_pattern "$restart_test" "source-root escape refusal" \
    'NomosManifestLoadError::SourceEscapesRoot[(]_[)]'
  require_source_pattern "$restart_test" "graph refusal has no receipt" \
    'assert_no_committed_receipt[(]&socket, [[]5[245][;] 32[]][)][;]'
  reject_source_pattern "$restart_test" "retired central storage relay" \
    'signal[_-]sema[_-]storage|SEMA_STORAGE_BIN|all four restarted daemons'
}

validate_native_nomos_source_boundary() {
  local source_map_file=$1
  local engine_root
  local -a production_sources

  engine_root=$(source_path "$source_map_file" nomos-engine) || {
    echo "native Nomos engine is absent from the root source map" >&2
    return 1
  }
  [[ -f "$engine_root/Cargo.toml" && ! -L "$engine_root/Cargo.toml" &&
    -d "$engine_root/src" && ! -L "$engine_root/src" ]] || {
    echo "native Nomos engine lacks regular production source surfaces" >&2
    return 1
  }
  if find "$engine_root/src" -type l -print -quit | grep -q .; then
    echo "native Nomos production source contains a symbolic link" >&2
    return 1
  fi
  mapfile -d '' -t production_sources < <(
    find "$engine_root/src" -type f -name '*.rs' -print0
  )
  (( ${#production_sources[@]} > 0 )) || {
    echo "native Nomos production source has no regular Rust files" >&2
    return 1
  }
  if LC_ALL=C rg -n -i \
    'MacroPackage|apply_enriched|enriched_fixture|wire_fixture|signal[_-]sema[_-]storage|sema-storage|SEMA_STORAGE_BIN|SemaPlane|output_slot|kameo' \
    "$engine_root/Cargo.toml" "${production_sources[@]}" >/dev/null; then
    echo "native Nomos production source retains a retired evaluator or central storage path" >&2
    return 1
  fi
}

validate_coherence() {
  local lock_file=$1
  local source_map_file=$2
  local source_name
  local dependency_name
  local target_name
  local package_name

  jq -e '
    type == "object"
    and all(to_entries[]; (.key | type == "string") and (.value | type == "string"))
  ' "$source_map_file" >/dev/null || {
    echo "root source map must be a JSON object of source paths" >&2
    return 1
  }

  while IFS='|' read -r \
    source_name dependency_name target_name package_name; do
    validate_direct_edge "$source_map_file" "$lock_file" \
      "$source_name" "$dependency_name" "$target_name" "$package_name" ||
      return 1
  done < <(printf '%s\n' "$expected_edges")

  validate_behavior_witness "$source_map_file" "$lock_file"
  validate_native_nomos_source_boundary "$source_map_file"
}

copy_affected_manifests() {
  local source_map_file=$1
  local fixture_root=$2
  local fixture_map='{}'
  local source_name
  local source_root

  while IFS= read -r source_name; do
    source_root=$(source_path "$source_map_file" "$source_name")
    mkdir -p "$fixture_root/sources/$source_name"
    cp "$source_root/Cargo.toml" \
      "$fixture_root/sources/$source_name/Cargo.toml"
    chmod u+w "$fixture_root/sources/$source_name/Cargo.toml"
    if [[ "$source_name" == language-engine-witness ]]; then
      mkdir -p "$fixture_root/sources/$source_name/tests/fixtures"
      mkdir -p "$fixture_root/sources/$source_name/tests/support"
      cp "$source_root/flake.nix" \
        "$fixture_root/sources/$source_name/flake.nix"
      cp "$source_root/tests/slice_one.rs" \
        "$fixture_root/sources/$source_name/tests/slice_one.rs"
      cp "$source_root/tests/spirit_domain.rs" \
        "$fixture_root/sources/$source_name/tests/spirit_domain.rs"
      cp "$source_root/tests/support/mod.rs" \
        "$fixture_root/sources/$source_name/tests/support/mod.rs"
      cp "$source_root/tests/fixtures/slice-one-newtype.ethos" \
        "$fixture_root/sources/$source_name/tests/fixtures/slice-one-newtype.ethos"
      cp "$source_root/tests/fixtures/spirit-domain.ethos" \
        "$fixture_root/sources/$source_name/tests/fixtures/spirit-domain.ethos"
      cp "$source_root/tests/nomos_authority_process.rs" \
        "$fixture_root/sources/$source_name/tests/nomos_authority_process.rs"
      chmod u+w "$fixture_root/sources/$source_name/flake.nix"
      chmod -R u+w "$fixture_root/sources/$source_name/tests"
    fi
    if [[ "$source_name" == nomos-engine ]]; then
      cp -R "$source_root/src" "$fixture_root/sources/$source_name/src"
      chmod -R u+w "$fixture_root/sources/$source_name/src"
    fi
    if [[ "$source_name" == sema-engine ]]; then
      mkdir -p "$fixture_root/sources/$source_name/schema"
      mkdir -p "$fixture_root/sources/$source_name/tests/fixtures"
      mkdir -p "$fixture_root/sources/$source_name/tests/support"
      cp "$source_root/schema/witness.sema" \
        "$fixture_root/sources/$source_name/schema/witness.sema"
      cp "$source_root/tests/generated_table.rs" \
        "$fixture_root/sources/$source_name/tests/generated_table.rs"
      cp "$source_root/tests/fixtures/generated_sema_table.rs" \
        "$fixture_root/sources/$source_name/tests/fixtures/generated_sema_table.rs"
      cp "$source_root/tests/support/mod.rs" \
        "$fixture_root/sources/$source_name/tests/support/mod.rs"
      chmod -R u+w "$fixture_root/sources/$source_name/schema" \
        "$fixture_root/sources/$source_name/tests"
    fi
    fixture_map=$(
      jq -cn \
        --argjson fixture_map "$fixture_map" \
        --arg source_name "$source_name" \
        --arg source_path "$fixture_root/sources/$source_name" \
        '$fixture_map + {($source_name): $source_path}'
    )
  done < <(
    {
      printf '%s\n' "$expected_edges" | cut -d '|' -f 1
      printf '%s\n' nomos-engine sema-engine
    } | LC_ALL=C sort -u
  )
  printf '%s\n' "$fixture_map" > "$fixture_root/source-map.json"
}

expect_coherence_rejection() {
  local label=$1
  local lock_file=$2
  local source_map_file=$3

  if validate_coherence "$lock_file" "$source_map_file" >/dev/null 2>&1; then
    echo "Slice One coherence mutation unexpectedly passed: $label" >&2
    return 1
  fi
}

run_self_test() {
  local lock_file=$1
  local source_map_file=$2
  local temporary_root
  local core_ethos_manifest
  local nomos_engine_manifest
  local nomos_engine_source
  local witness_manifest
  local witness_flake
  local witness_nomos_process_test
  local witness_slice_fixture
  local witness_slice_test
  local witness_spirit_domain_fixture
  local witness_spirit_domain_test
  local witness_support_module
  local rust_logos_manifest
  local sema_fixture
  local sema_generated_test
  local structural_codec_revision

  validate_coherence "$lock_file" "$source_map_file"
  temporary_root=$(mktemp -d)
  trap 'rm -rf "$temporary_root"' RETURN
  copy_affected_manifests "$source_map_file" "$temporary_root"
  core_ethos_manifest="$temporary_root/sources/core-ethos/Cargo.toml"
  nomos_engine_manifest="$temporary_root/sources/nomos-engine/Cargo.toml"
  nomos_engine_source="$temporary_root/sources/nomos-engine/src/lib.rs"
  witness_manifest="$temporary_root/sources/language-engine-witness/Cargo.toml"
  witness_flake="$temporary_root/sources/language-engine-witness/flake.nix"
  witness_nomos_process_test="$temporary_root/sources/language-engine-witness/tests/nomos_authority_process.rs"
  witness_slice_fixture="$temporary_root/sources/language-engine-witness/tests/fixtures/slice-one-newtype.ethos"
  witness_slice_test="$temporary_root/sources/language-engine-witness/tests/slice_one.rs"
  witness_spirit_domain_fixture="$temporary_root/sources/language-engine-witness/tests/fixtures/spirit-domain.ethos"
  witness_spirit_domain_test="$temporary_root/sources/language-engine-witness/tests/spirit_domain.rs"
  witness_support_module="$temporary_root/sources/language-engine-witness/tests/support/mod.rs"
  rust_logos_manifest="$temporary_root/sources/rust-logos/Cargo.toml"
  sema_fixture="$temporary_root/sources/sema-engine/schema/witness.sema"
  sema_generated_test="$temporary_root/sources/sema-engine/tests/generated_table.rs"
  structural_codec_revision=$(root_revision "$lock_file" structural-codec)

  sed -i \
    '/^[[:space:]]*structural-codec[[:space:]]*=/s/[0-9a-f]\{40\}/0000000000000000000000000000000000000000/' \
    "$core_ethos_manifest"
  expect_coherence_rejection "canonical producer revision drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" nomos-engine)/Cargo.toml" \
    "$nomos_engine_manifest"
  sed -i \
    '/^[[:space:]]*signal-nomos[[:space:]]*=/s/[0-9a-f]\{40\}/0000000000000000000000000000000000000000/' \
    "$nomos_engine_manifest"
  expect_coherence_rejection "native Nomos protocol revision drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" nomos-engine)/src/lib.rs" \
    "$nomos_engine_source"
  printf '%s\n' 'const LEGACY_OUTPUT_SLOT: &str = "output_slot";' \
    >> "$nomos_engine_source"
  expect_coherence_rejection "retired path in recursively discovered production source" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" rust-logos)/Cargo.toml" \
    "$rust_logos_manifest"
  sed -i \
    '/^[[:space:]]*raw-discovery[[:space:]]*=/s#LiGoldragon/raw-discovery.git#LiGoldragon/core-logos.git#' \
    "$rust_logos_manifest"
  expect_coherence_rejection "producer repository drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/Cargo.toml" \
    "$witness_manifest"
  sed -i \
    '/^[[:space:]]*slice-structural-codec[[:space:]]*=/s/package[[:space:]]*=[[:space:]]*"structural-codec"/package="raw-discovery"/' \
    "$witness_manifest"
  expect_coherence_rejection "alias package drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/Cargo.toml" \
    "$witness_manifest"
  sed -i \
    '/github:LiGoldragon\/nomos-engine\//s/[0-9a-f]\{40\}/0000000000000000000000000000000000000000/' \
    "$witness_flake"
  expect_coherence_rejection "process-only Nomos engine revision drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/flake.nix" \
    "$witness_flake"

  cp "$(source_path "$source_map_file" rust-logos)/Cargo.toml" \
    "$rust_logos_manifest"
  printf \
    'structural-codec = { git = "https://github.com/LiGoldragon/structural-codec.git", rev = "%s" }\n' \
    "$structural_codec_revision" >> "$rust_logos_manifest"
  expect_coherence_rejection "duplicate producer declaration" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/slice_one.rs" \
    "$witness_slice_test"
  sed -i \
    's/assert_eq!(assembly[.]canonical_source(), NEXUS_SOURCE);/assert_ne!(assembly.canonical_source(), NEXUS_SOURCE);/' \
    "$witness_slice_test"
  expect_coherence_rejection "canonical Nexus transaction equality removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/slice_one.rs" \
    "$witness_slice_test"
  sed -i '1s/^Nexus[.]/Sema./' "$witness_slice_fixture"
  expect_coherence_rejection "Nexus header drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/fixtures/slice-one-newtype.ethos" \
    "$witness_slice_fixture"
  sed -i '2s/^\[\]$/[Universal]/' "$witness_slice_fixture"
  expect_coherence_rejection "Nexus imports drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/fixtures/slice-one-newtype.ethos" \
    "$witness_slice_fixture"
  sed -i 's/Identifiers[.]Vector/Identifiers.List/' "$witness_slice_fixture"
  expect_coherence_rejection "Nexus body drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/fixtures/slice-one-newtype.ethos" \
    "$witness_slice_fixture"
  sed -i '1s/^Sema[.]/Nexus./' "$sema_fixture"
  expect_coherence_rejection "Sema header drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" sema-engine)/schema/witness.sema" \
    "$sema_fixture"
  sed -i \
    's/generated_domain_snapshot_table_writes_and_reads_a_typed_domain_key/generated_domain_snapshot_table_is_not_exercised/' \
    "$sema_generated_test"
  expect_coherence_rejection "Sema generated runtime witness removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" sema-engine)/tests/generated_table.rs" \
    "$sema_generated_test"
  sed -i \
    's/[(]38, 3, 369, 37[)]/(38, 3, 368, 37)/' \
    "$witness_spirit_domain_test"
  expect_coherence_rejection "Spirit domain inventory drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/spirit_domain.rs" \
    "$witness_spirit_domain_test"
  sed -i \
    '0,/[.]emit_with_type_paths/s//.emit_fixture/' \
    "$witness_spirit_domain_test"
  expect_coherence_rejection "Spirit production emission replacement" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/spirit_domain.rs" \
    "$witness_spirit_domain_test"
  sed -i '1s/^Interface[.]/Nexus./' "$witness_spirit_domain_fixture"
  expect_coherence_rejection "Interface header drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/fixtures/spirit-domain.ethos" \
    "$witness_spirit_domain_fixture"
  sed -i \
    's/^pub const SIGNAL_DOMAIN_REVISION: &str = "[0-9a-f]\{40\}";/pub const SIGNAL_DOMAIN_REVISION: \&str = "0000000000000000000000000000000000000000";/' \
    "$witness_support_module"
  expect_coherence_rejection "Interface source revision drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/support/mod.rs" \
    "$witness_support_module"
  sed -i \
    's/NomosRejection::EthosPopulationInvalid/NomosRejection::SlotMissing/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "unarchived current-wire refusal drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/NomosLoadError::ReceiptNotDurableSeal/NomosLoadError::ReceiptUnknown/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "unread authority receipt refusal removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/^ScopeOfStep[.]Recursive[.]Enumeration [{]$/ScopeOfStep.Structural.Enumeration {/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "recursive declaration witness removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/^InsertAt[.]children 0 rustfmt[.]skip$/InsertAt.children 1 rustfmt.skip/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "InsertAt boundary witness drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/let mut recovered_daemon = Daemon::start[(]&socket, &database[)]/let mut recovered_daemon = Daemon::start(\&socket, \&other_database)/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "authority recovery state drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/AuthorityOperation::Rename[(]Rename [{]/AuthorityOperation::Read(ReadOperation::Current)/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "authorized rename witness removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/NoWriteFailure::UnresolvedReference/NoWriteFailure::ScopeUnknown/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "unresolved authored reference refusal drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/NomosManifestLoadError::ExternalInvoke/NomosManifestLoadError::MissingDependency/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "manifest external Invoke refusal drift" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i 's/assert_no_committed_receipt/allow_committed_receipt/g' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "graph refusal receipt witness removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/recv_timeout[(]PROCESS_STARTUP_TIMEOUT[)]/recv()/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "bounded process readiness removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/set_read_timeout[(]Some[(]PROCESS_IO_TIMEOUT[)][)]/set_nonblocking(true)/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "bounded process read removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i \
    's/set_write_timeout[(]Some[(]PROCESS_IO_TIMEOUT[)][)]/set_nonblocking(true)/' \
    "$witness_nomos_process_test"
  expect_coherence_rejection "bounded process write removal" \
    "$lock_file" "$temporary_root/source-map.json"

  cp "$(source_path "$source_map_file" language-engine-witness)/tests/nomos_authority_process.rs" \
    "$witness_nomos_process_test"
  sed -i 's/[.]to_be_bytes[(][)]/.to_le_bytes()/' "$witness_nomos_process_test"
  expect_coherence_rejection "process framing byte-order drift" \
    "$lock_file" "$temporary_root/source-map.json"
}

case ${1:-} in
  --self-test)
    (( $# == 3 )) || {
      echo "usage: check-slice-one-coherence --self-test FLAKE_LOCK SOURCE_MAP_JSON" >&2
      exit 2
    }
    run_self_test "$2" "$3"
    echo "Slice One mutations reject producer, header/import/body, transaction, authority, current-wire, timeout, framing, and refusal drift"
    ;;
  "")
    echo "usage: check-slice-one-coherence FLAKE_LOCK SOURCE_MAP_JSON" >&2
    exit 2
    ;;
  *)
    (( $# == 2 )) || {
      echo "usage: check-slice-one-coherence FLAKE_LOCK SOURCE_MAP_JSON" >&2
      exit 2
    }
    validate_coherence "$1" "$2"
    echo "Slice One edges and Interface/Nexus/Sema behavior witness match exact published revisions"
    ;;
esac
